# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=JMAP Mail

# "production" (default in Docker) or "development" (local dev without HTTPS)
ENVIRONMENT=production

# Required in production — must match your public URL exactly (no trailing slash)
APP_URL=https://mail.example.com

# ── Stalwart Mail Server ──────────────────────────────────────────────────────
STALWART_URL=https://mail.example.com

# ── OAuth2 ────────────────────────────────────────────────────────────────────
# Create an OAuth2 client in the Stalwart admin panel (Management › Directory › OAuth Clients):
#   Client ID:     must exactly match OAUTH_CLIENT_ID below
#   Client Secret: must exactly match OAUTH_CLIENT_SECRET below
#   Redirect URI:  must exactly match OAUTH_REDIRECT_URI below
OAUTH_CLIENT_ID=jmap-webclient
OAUTH_CLIENT_SECRET=your-client-secret-here

# Must exactly match the redirect URI registered in the Stalwart OAuth client record.
# For local Docker: http://localhost:8000/auth/callback
# For production:   https://mail.yourdomain.com/auth/callback
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Scopes to request — Stalwart uses JMAP-specific URN scopes, not "email profile".
# OAUTH_SCOPE=openid offline_access urn:ietf:params:jmap:core urn:ietf:params:jmap:mail

# ── Session security ──────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Note: in development (ENVIRONMENT=development), https_only is disabled automatically
# so the session cookie works over plain HTTP.
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# ── Optional overrides ────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# FRONTEND_STATIC_DIR=/app/static
