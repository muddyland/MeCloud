# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=JMAP Mail

# "production" (default in Docker) or "development" (local dev without HTTPS)
ENVIRONMENT=production

# Required in production — must match your public URL exactly (no trailing slash)
APP_URL=https://mail.example.com

# ── Stalwart Mail Server ──────────────────────────────────────────────────────
STALWART_URL=https://mail.example.com

# ── OAuth2 ────────────────────────────────────────────────────────────────────
# Create an OAuth2 client in the Stalwart admin panel (Management › Directory › OAuth Clients):
#   Client ID:     must exactly match OAUTH_CLIENT_ID below
#   Client Secret: must exactly match OAUTH_CLIENT_SECRET below
#   Redirect URI:  must exactly match OAUTH_REDIRECT_URI below
OAUTH_CLIENT_ID=jmap-webclient
OAUTH_CLIENT_SECRET=your-client-secret-here

# Must exactly match the redirect URI registered in the Stalwart OAuth client record.
# For local Docker: http://localhost:8000/auth/callback
# For production:   https://mail.yourdomain.com/auth/callback
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Scopes to request — Stalwart uses JMAP-specific URN scopes, not "email profile".
# OAUTH_SCOPE=openid offline_access urn:ietf:params:jmap:core urn:ietf:params:jmap:mail

# ── Session security ──────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
#
# This key encrypts the session cookie (Fernet / AES + HMAC), which is where the
# OAuth access and refresh tokens live. Treat it like a private key:
#   • must be at least 32 characters in production — the app refuses to start otherwise
#   • rotating it immediately invalidates every signed-in session
# In development (ENVIRONMENT=development) the Secure flag is dropped so the
# cookie still works over plain HTTP.
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# ── Optional overrides ────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# FRONTEND_STATIC_DIR=/app/static

# Sliding session lifetime in seconds (default 7 days). The cookie is re-issued
# once it passes half its life, so an active user is never logged out mid-task.
# SESSION_MAX_AGE=604800

# Largest accepted request body, in bytes (default 1 MiB). JMAP requests are
# small; the cap is there so a large POST cannot exhaust memory.
# MAX_REQUEST_BYTES=1048576

# Upstream timeouts, in seconds. Without these a hung mail server pins a worker
# and its connection indefinitely.
# UPSTREAM_CONNECT_TIMEOUT=5
# UPSTREAM_READ_TIMEOUT=30

# Cap on concurrent Server-Sent Event streams. Each one holds an upstream
# connection open, so an unbounded count is a self-inflicted denial of service.
# MAX_EVENT_STREAMS=64
