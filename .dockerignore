# The build context is everything Docker uploads before the first instruction.
# Without this file that included the Rust target directory (tens of GB), the
# host's node_modules (built for the host's libc, then layered over the image's
# own `npm ci`), and every cache below.

.git
.gitignore
.gitlab-ci.yml
.env
*.env.local
docs/

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Node / SvelteKit
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
frontend/static/icons/

# Rust
desktop/**/target/
desktop/.cargo-cache/
desktop/src-tauri/gen/

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*.log
