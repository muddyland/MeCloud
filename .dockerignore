# The build context is everything Docker uploads before the first instruction.
# Without this file that included the Rust target directories (tens of GB), the
# host's node_modules (built for the host's libc, then layered over the image's
# own `npm ci`), and every cache below.

.git
.gitignore
.gitlab-ci.yml
.env
*.env.local
docs/

# Node / SvelteKit
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
frontend/static/icons/

# Rust
desktop/**/target/
server/target/
desktop/.cargo-cache/
desktop/src-tauri/gen/

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*.log
