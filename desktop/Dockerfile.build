# Build environment for the MeCloud desktop client.
#
# Pinned to trixie to match the Debian the app is built for: Tauri links
# against the system WebKitGTK, so a binary built on a newer glibc/webkit than
# the target simply refuses to start.
FROM rust:1-trixie

RUN apt-get update && apt-get install -y --no-install-recommends \
      libwebkit2gtk-4.1-dev \
      libgtk-3-dev \
      libayatana-appindicator3-dev \
      librsvg2-dev \
      libsoup-3.0-dev \
      libssl-dev \
      pkg-config \
      build-essential \
      curl file ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV CARGO_HOME=/cargo
RUN mkdir -p /cargo && chmod 777 /cargo
WORKDIR /src
