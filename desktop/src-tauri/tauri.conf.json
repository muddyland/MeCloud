{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeCloud",
  "version": "0.3.0",
  "identifier": "xyz.mudhut.mecloud.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Network",
    "shortDescription": "MeCloud desktop client",
    "longDescription": "Desktop client for MeCloud: the web apps in a native window, with OS integration.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    }
  }
}
